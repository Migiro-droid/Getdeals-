# Production Environment Variables for GetDeals Kenya

# M-Pesa Configuration (Server-Side - Move to Vercel Environment Variables)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_ENVIRONMENT=production

# Application Settings
NODE_ENV=production
VITE_API_URL=https://getdeals.co.ke/api

# Supabase Production Configuration
VITE_SUPABASE_URL=your_production_supabase_url
VITE_SUPABASE_ANON_KEY=your_production_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

# Database URLs (Production)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security
VITE_ADMIN_PIN=YOUR_SECURE_ADMIN_PIN
VITE_STAFF_PIN=YOUR_SECURE_STAFF_PIN

# Email Configuration (Production)
EMAIL_HOST=your_production_email_host
EMAIL_PORT=587
EMAIL_USER=your_production_email
EMAIL_PASS=your_production_email_password

# SMS Configuration (Production)
SMS_API_KEY=your_production_sms_api_key
SMS_USERNAME=your_production_sms_username

# Leta Delivery Configuration (Production)
VITE_LETA_API_URL=https://integrations.leta.ai
VITE_LETA_TOKEN=9ad8af7c3ea3674aee27c3ea8e59928606852820
LETA_API_TOKEN=9ad8af7c3ea3674aee27c3ea8e59928606852820