# M-Pesa Production Configuration Template
# Replace with your actual production credentials

# PRODUCTION M-Pesa Credentials (from Safaricom Developer Portal)
MPESA_CONSUMER_KEY=your_production_consumer_key
MPESA_CONSUMER_SECRET=your_production_consumer_secret
MPESA_PASSKEY=your_production_passkey
MPESA_SHORTCODE=your_production_shortcode
MPESA_ENVIRONMENT=production

# Production Callback URL (MUST be HTTPS and publicly accessible)
MPESA_CALLBACK_URL=https://getdeals.co.ke/api/payments/mpesa/callback

# Server Configuration
PORT=3001
NODE_ENV=production

# Security Settings (Add these for production)
ALLOWED_ORIGINS=https://getdeals.co.ke,https://www.getdeals.co.ke
API_SECRET_KEY=your_secret_api_key_here
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/mpesa-service.log